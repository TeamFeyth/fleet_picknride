{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pnr-lead-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  "observability": { "enabled": true },

  // DEALERCENTER_ACCESS_TOKEN is a SECRET and must never live in this file:
  //   npx wrangler secret put DEALERCENTER_ACCESS_TOKEN
  // Request it from support@dealercenter.com with the landing page URL.
  "vars": {
    // PRODUCTION. Validated against the integration environment first, then
    // switched over on 2026-08-18 once DealerCenter confirmed the test lead.
    "DEALERCENTER_ENDPOINT": "https://app.dealercenter.net/api-gateway/crm-externalintegration/LeadManagement/post-xml",
    "DEALERCENTER_DEALER_ID": "22065582",

    // To re-test against integration, swap the two lines above for these. The
    // integration environment REQUIRES the literal dealer id "NOWCOM"; sending
    // the real Company ID there fails with "Invalid Dealer ID".
    // "DEALERCENTER_ENDPOINT": "https://app-int0.dealercenter.net/api-gateway/crm-externalintegration/LeadManagement/post-xml",
    // "DEALERCENTER_DEALER_ID": "NOWCOM",

    // Google Sheets backup.
    //
    // DO NOT put the Apps Script URL here. This repository is PUBLIC, and an
    // Apps Script Web App deployed with "Anyone" access is a write endpoint:
    // whoever has the URL can append rows. Both values are secrets:
    //
    //   wrangler secret put SHEETS_WEBHOOK_URL     # the .../exec URL
    //   wrangler secret put SHEETS_SHARED_SECRET   # same string as SECRET in the script
    //
    // Empty = feature off, and the Worker behaves exactly as it did before.

    // Cloudflare Turnstile.
    //
    // TURNSTILE_SECRET is a SECRET and must never appear in this file — this
    // repository is public:
    //   wrangler secret put TURNSTILE_SECRET
    //
    // The switch below lives here rather than in the dashboard on purpose.
    // `wrangler deploy` REPLACES the plain-text vars of the Worker with this
    // block, so anything typed into the dashboard is silently wiped on the
    // next deploy. Secrets survive; plain vars do not.
    //
    // Roll-out: deploy with "false", ship the landing pages, submit one real
    // lead on each, then flip to "true" and deploy again. While it is false a
    // failed challenge is logged and let through, so the gap between the two
    // deploys costs nothing.
    "TURNSTILE_ENFORCE": "false",

    "LEAD_SOURCE": "Feyth Marketing - Landing Page",

    // Comma-separated. Add each landing page origin.
    "ALLOWED_ORIGINS": "https://picknride-fleet-lp.pages.dev,https://picknride-usedcars-lp.pages.dev,https://fleet.picknrideauto.com,https://call.picknrideauto.com,http://localhost:8788,http://localhost:8789,http://127.0.0.1:8788,http://127.0.0.1:8789"
  }
}
